# Keep browser API calls same-origin in local development. Next.js forwards
# /api/v1 through BACKEND_INTERNAL_LOCAL_URL, avoiding localhost CORS failures.
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_INTERNAL_LOCAL_URL=https://virtujudge-backend.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
BACKEND_INTERNAL_URL=
BACKEND_INTERNAL_LOCAL_URL=
